# PostgreSQL connection (default in src/database/database.module.ts).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/core_api
# Cloud non-production instance (see infra/postgres/README.md): take host and credentials from the
# managed secret, never commit them.
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>:5432/core_api
# OpenTelemetry collector (OTLP/HTTP). Leave unset to turn tracing off.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
